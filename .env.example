# Copy this file to .env and fill in your own values.
# NEVER put real Cloudflare R2 credentials in a file that is committed to git.

# Cloudflare R2 Storage Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=ennvo-storage
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# Server & Native Configuration
PORT=3000
NODE_ENV=development
